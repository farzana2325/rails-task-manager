<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Task Manager</h1>
    <%= link_to "New Task", new_task_path, class: "btn btn-primary" %>
  </div>

  <ul class="list-group">
    <% @tasks.each do |task| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <div>
          <% if task.completed %>
            <i class="fa-regular fa-square-check text-success me-2"></i>
          <% else %>
            <i class="fa-regular fa-square text-secondary me-2"></i>
          <% end %>
          <%= link_to task.title, task_path(task) %>
        </div>
        <%= link_to task_path(task), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-danger btn-sm" do %>
          <i class="fa-solid fa-trash"></i>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
