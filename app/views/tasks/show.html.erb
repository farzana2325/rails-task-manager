<div class="container mt-5">
  <div class="card">
    <div class="card-body">
      <h1 class="card-title"><%= @task.title %></h1>
      <p class="card-text"><%= @task.details %></p>
      <p>
        <% if @task.completed %>
          <i class="fa-regular fa-square-check text-success me-2"></i> Completed
        <% else %>
          <i class="fa-regular fa-square text-secondary me-2"></i> Not completed
        <% end %>
      </p>

      <div class="d-flex gap-2">
        <%= link_to "Edit", edit_task_path(@task), class: "btn btn-warning" %>
        <%= link_to "Back to list", tasks_path, class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
</div>
