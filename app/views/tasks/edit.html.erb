<div class="container mt-5">
  <h1 class="mb-4">Edit Task</h1>

  <%= form_with model: @task, url: task_path(@task), method: :patch do |f| %>
    <div class="mb-3">
      <%= f.label :title, class: "form-label" %>
      <%= f.text_field :title, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :details, class: "form-label" %>
      <%= f.text_area :details, class: "form-control", rows: 4 %>
    </div>

    <div class="mb-3 form-check">
      <%= f.check_box :completed, class: "form-check-input" %>
      <%= f.label :completed, class: "form-check-label" %>
    </div>

    <div class="d-flex gap-2">
      <%= f.submit "Update Task", class: "btn btn-warning" %>
      <%= link_to "Cancel", task_path(@task), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
