<div class="container mt-5">
  <h1 class="mb-4">New Task</h1>

  <%= form_with model: @task, url: tasks_path do |f| %>
    <div class="mb-3">
      <%= f.label :title, class: "form-label" %>
      <%= f.text_field :title, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :details, class: "form-label" %>
      <%= f.text_area :details, class: "form-control", rows: 4 %>
    </div>

    <div class="d-flex gap-2">
      <%= f.submit "Create Task", class: "btn btn-primary" %>
      <%= link_to "Cancel", tasks_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
